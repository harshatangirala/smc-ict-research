# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
*.egg

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.conda/

# --- Environment / secrets ---
.env
.env.*
*.key
secrets.toml

# --- Market data cache (large, regenerable) ---
data/cache/
data/raw/*.parquet
data/raw/*.feather
!data/raw/sp500_constituents.csv

# --- Generated research outputs ---
# The large intermediates (trades.parquet is ~390 MB) stay out of git and are
# regenerated by the pipeline. The small published artefacts -- the tables and
# reports the manuscript cites, plus the figures -- are committed so a reviewer
# can check every claim without a 90-minute run.
results/*
!results/.gitkeep
!results/*.csv
!results/*.md
!results/*.json
!results/seed.txt
!results/figures/
!results/figures/*
results/*.parquet
results/runs/
results/*.zip
exports/*
!exports/.gitkeep

# --- Logs ---
logs/
*.log

# --- Jupyter ---
.ipynb_checkpoints/

# --- Testing / coverage ---
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Gradio ---
gradio_cached_examples/
flagged/

# Generated intermediate: rebuilt by tools/build_manuscript_pdf.py from
# docs/manuscript.md, and 1.1 MB of it is base64-embedded figures.
docs/manuscript.html
